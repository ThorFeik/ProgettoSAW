rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = utente con documento users/{uid} contenente ruolo == 'admin'.
    // I documenti users/* si creano solo dalla console Firebase (nessuna scrittura dal client).
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.ruolo == 'admin';
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /settings/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /patients/{id} {
      allow read, write: if request.auth != null;
    }
    match /appointments/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
